# =============================================================================
# BERT News Category Fine-tuning — Environment Variables
# =============================================================================
# Copy this file to the same directory as news_category_finetune.py and fill
# in your values. Never commit this file to version control.
# =============================================================================


# ─── EMAIL NOTIFICATIONS ──────────────────────────────────────────────────────

# Enable or disable email notifications entirely (true / false)
EMAIL_NOTIFICATIONS_ENABLED=true

# The Gmail (or other SMTP) address that SENDS the notification
EMAIL_SENDER=

# App Password for the sender account.
# Gmail: https://myaccount.google.com/apppasswords
# Outlook: https://account.live.com/proofs/manage
# (Do NOT use your normal login password here)
EMAIL_APP_PASSWORD=

# The address that RECEIVES the notification (can be the same as sender)
EMAIL_RECIPIENT=

# SMTP server settings (defaults work for Gmail)
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587

# Human-readable name shown in notification subject / body
TRAINING_news_category=BERT News Category Fine-tuning
TRAINING_news_source=BERT News Source Fine-tuning
TRAINING_sentiment_comments=BERT Sentiment Comments Fine-tuning
TRAINING_sentiment_context=BERT Sentiment Context Fine-tuning
TRAINING_writing_style=BERT Writing Style Fine-tuning


# ─── WEIGHTS & BIASES ─────────────────────────────────────────────────────────

# Your W&B API key (get it from https://wandb.ai/authorize)
# If set here, wandb will authenticate automatically.
# WANDB_API_KEY=your_wandb_api_key_here